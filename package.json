{
  "name": "exam-generator",
  "version": "0.1.0",
  "description": "Serverless backend for the mock-exam generator.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "PATH=$(pwd)/node_modules/.bin:$PATH sam build -t infra/template.yaml",
    "build:watch": "PATH=$(pwd)/node_modules/.bin:$PATH sam build -t infra/template.yaml --beta-features",
    "start": "PATH=$(pwd)/node_modules/.bin:$PATH sam local start-api -t infra/template.yaml --warm-containers EAGER",
    "start:generate": "PATH=$(pwd)/node_modules/.bin:$PATH sam local generate-event sqs receive-message | PATH=$(pwd)/node_modules/.bin:$PATH sam local invoke -t infra/template.yaml GeneratorFunction",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && eslint src",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "deploy": "PATH=$(pwd)/node_modules/.bin:$PATH sam deploy --guided -t infra/template.yaml",
    "deploy:ci": "PATH=$(pwd)/node_modules/.bin:$PATH sam deploy --no-confirm-changeset --no-fail-on-empty-changeset -t infra/template.yaml",
    "seed:certifications": "PATH=$(pwd)/node_modules/.bin:$PATH esbuild scripts/seed-certification.ts --bundle --platform=node --format=cjs --outfile=.build/seed-certification.cjs && PATH=$(pwd)/node_modules/.bin:$PATH node .build/seed-certification.cjs",
    "promote:admin": "PATH=$(pwd)/node_modules/.bin:$PATH esbuild scripts/promote-admin.ts --bundle --platform=node --format=cjs --outfile=.build/promote-admin.cjs && PATH=$(pwd)/node_modules/.bin:$PATH node .build/promote-admin.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.600.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1109.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@middy/core": "^5.4.0",
    "@middy/http-cors": "^5.4.0",
    "@middy/http-error-handler": "^5.4.0",
    "@middy/http-json-body-parser": "^5.4.0",
    "@middy/validator": "^7.7.2",
    "pdfmake": "^0.3.11",
    "uuid": "^14.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.131",
    "@types/node": "^20.10.0",
    "@types/pdfmake": "^0.3.3",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  }
}
