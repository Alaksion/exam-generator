{
  "name": "exam-generator",
  "version": "0.1.0",
  "description": "Serverless backend for the mock-exam generator.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "PATH=$(pwd)/node_modules/.bin:$PATH sam build",
    "build:watch": "PATH=$(pwd)/node_modules/.bin:$PATH sam build --beta-features",
    "start": "PATH=$(pwd)/node_modules/.bin:$PATH sam local start-api --warm-containers EAGER",
    "start:generate": "PATH=$(pwd)/node_modules/.bin:$PATH sam local generate-event sqs receive-message | PATH=$(pwd)/node_modules/.bin:$PATH sam local invoke GeneratorFunction",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && eslint src",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "deploy": "PATH=$(pwd)/node_modules/.bin:$PATH sam deploy --guided",
    "deploy:ci": "PATH=$(pwd)/node_modules/.bin:$PATH sam deploy --no-confirm-changeset --no-fail-on-empty-changeset"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@middy/core": "^5.4.0",
    "@middy/http-cors": "^5.4.0",
    "@middy/http-error-handler": "^5.4.0",
    "@middy/http-json-body-parser": "^5.4.0",
    "@middy/validator": "^5.4.0",
    "esbuild": "^0.19.8",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.131",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "esbuild": "^0.19.8",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
