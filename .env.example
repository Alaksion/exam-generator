# Example environment variables for local development.
# Copy this file to .env and fill in real values.

AWS_REGION=us-east-1

# Comma-separated origins allowed to call the public API (CORS).
# Set via the AllowedOrigins stack parameter on deploy; override here for local runs.
ALLOWED_ORIGINS=http://localhost:5173

# Cognito identity provider values injected by SAM at runtime.
# COGNITO_USER_POOL_ID=cognito-idp.us-east-1.amazonaws.com/<user-pool-id>
# COGNITO_USER_POOL_CLIENT_ID=<app-client-id>

# These are set automatically by SAM when running locally, but you can
# override them here if you want to point at already-deployed resources.
# DYNAMODB_CERTIFICATIONS_TABLE=exam-generator-dev-certifications
# DYNAMODB_EXAMS_TABLE=exam-generator-dev-exams
# SQS_GENERATOR_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/...
# S3_ARTIFACTS_BUCKET=exam-generator-dev-artifacts-...
# BEDROCK_MODEL_DEFAULT=amazon.nova-lite-v1:0
